void merge(struct Production_data batch[], int left, int middle, int right) // combine both halves of the array
{
    int i , j = 0;
    int k = left;
    int size1 = middle - left + 1;//size for left array
    int size2 = right - middle;//size for right array

    struct Production_data left_half[size1], right_half[size2];

    for (i = 0; i < size1; i++)// copy the data into the left half array
    {
        left_half[i] = batch[left + i];
    }
    for (j = 0; j < size2; j++)// copy to the right half
    {
        right_half[j] = batch[middle + 1 + j];
    }

    i = 0;
    j = 0;

    while (i < size1 && j < size2)// Merge the two halves back into one array in sorted order by weight
    {
        if (left_half[i].weight <= right_half[j].weight)// compare weights and add smaller one into the array
        {
            batch[k++] = left_half[i++];
        } 
        else 
        {
            batch[k++] = right_half[j++];
        }
    }

    while (i < size1)// Copy any left over elements from the left half
    {
        batch[k++] = left_half[i++];
    }
    while (j < size2)// Copy any from the right half
    {
        batch[k++] = right_half[j++];
    }
}

void mergeSort(struct Production_data batch[], int left, int right) //O(NLog(N))
{
    // This is the base case, ensuring there are at least 2 elements
    if (left < right) 
    {
        int middle = left + (right - left) / 2;// Find the middle of the array

        mergeSort(batch, left, middle);// Using recursion sorts the left half
        mergeSort(batch, middle + 1, right);//sorts right half
        merge(batch, left, middle, right);// uses merge function to make a single array
    }
}

int binary_Search_Weight(struct Production_data batch[], int total, float input_Weight) // Use weight to search Binary
{
    int lowest = 0;
    int highest = total - 1;
    int result = -1;

    while (lowest <= highest)//search while low is less than high
    {
        int mid = (lowest + highest) / 2;

        if (batch[mid].weight == input_Weight)// If middle matches weight
        {
            result = mid;// Match found
            highest = mid - 1;// keep checking for an earlier match
        } 
        else if (batch[mid].weight < input_Weight) // if the weight at the middle is less then the weight to be found
        {
            lowest = mid + 1;
        }
        else // if the weight at the middle larger then the input weight
        {
            highest = mid - 1;
        }
    }

    return result;
}
