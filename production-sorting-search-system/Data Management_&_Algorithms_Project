        total_weight += all_batches[i].weight;//sum of batch weight
        total_price += all_batches[i].price;//sum of batch weight
        i++;
    }

    printf("Total weight of all products KG: %.2f\n", total_weight);//Display total weight
    printf("Total price of all products: Euro: %.2f\n", total_price);//Display total price
    printf("Total  products in delivery van: %d\n",total);//Display total


